@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam component {
  BackgroundColor #F5F9FF
  BorderColor #3A6EA5
}
skinparam packageBorderColor #7A8BA0
title Component Diagram - Kiến trúc BlueMoon

package "Frontend (React 18 + Chakra UI)" {
  [Màn hình xác thực\n(signIn, signUp, verify,\nforgotPassword, verifyForgot)] as FE_Auth
  [Màn hình quản trị\n(user, apartment, bill, feeUnit,\nutilities, contributions)] as FE_Admin
  [Màn hình cư dân\n(profile, payment, contribution)] as FE_User
  [AuthGuard + routes.js] as FE_Guard
  [services/apiConfig\n(axios + Bearer JWT)] as FE_Api
}

package "Backend (Spring Boot 3, Java 17)" {
  package "security" {
    [HomeSecurity\n(phân quyền URL, CORS, BCrypt)] as SecCfg
    [JwtAuthenticationFilter] as JwtFilter
    [CurrentUserAccess\n(cư dân chỉ xem căn hộ mình)] as Access
  }
  package "controller (REST /api/**)" as CTRL {
    [Auth, Register, ForgotPassword] as C_Auth
    [AdminListUser, Resident, User] as C_User
    [ApartmentAPI, AdminListApartment] as C_Apt
    [ApartmentFeeUnit] as C_Fee
    [Bill, AdminBill, UtilityBillBatch] as C_Bill
    [Contribution, ContributionType] as C_Contrib
    [export: User, Contribution Excel] as C_Export
  }
  package "service" {
    [JwtService] as S_Jwt
    [OTPService\n(Caffeine cache)] as S_Otp
    [MailService] as S_Mail
    [UserService, ResidentService,\nApartmentService] as S_Core
    [ApartmentFeeUnitService, BillService] as S_Bill
    [ContributionService, ContributionTypeService,\nResidentContributionService] as S_Contrib
    [ExcelExportUtil\n(Apache POI)] as S_Excel
  }
  [validation\n(UniqueEmail, ValidPassword,\nApartmentsExists...)] as Valid
  [repository\n(Spring Data JPA)] as Repo
  [config\n(AdminUserInitializer, ApartmentConfig)] as Init
}

database "PostgreSQL\nchungcu_db" as PG
cloud "Gmail SMTP\nsmtp.gmail.com:587" as Gmail

interface "REST API\nJSON qua HTTP" as REST
interface "JDBC" as JDBC
interface "SMTP" as SMTP

FE_Auth --> FE_Api
FE_Admin --> FE_Api
FE_User --> FE_Api
FE_Guard ..> FE_Admin
FE_Guard ..> FE_User
FE_Api --> REST

REST - JwtFilter
JwtFilter --> S_Jwt
JwtFilter --> SecCfg
SecCfg ..> CTRL : phân quyền mọi /api/**

C_Auth --> S_Otp
C_Auth --> S_Jwt
C_Auth --> S_Core
C_User --> S_Core
C_Apt --> S_Core
C_Fee --> S_Bill
C_Bill --> S_Bill
C_Bill --> Access
C_Contrib --> S_Contrib
C_Export --> S_Excel
C_Export --> S_Core
C_Export --> S_Contrib
C_Auth ..> Valid
C_User ..> Valid

S_Otp --> S_Mail
S_Core --> Repo
S_Bill --> Repo
S_Contrib --> Repo
S_Otp --> Repo
Init --> Repo

Repo - JDBC
JDBC --> PG
S_Mail - SMTP
SMTP --> Gmail
@enduml
