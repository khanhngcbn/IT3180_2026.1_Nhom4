@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam participant {
  BackgroundColor #F5F9FF
  BorderColor #3A6EA5
}
autonumber
title Sequence Diagram - Đăng nhập JWT và xem khoản phải thu (US22, US08)

actor "Cư dân" as U
participant "Frontend\n(React SPA)" as FE
participant "AuthController" as AC
participant "AuthenticationManager" as AM
participant "CustomUserDetailsService" as UDS
database "PostgreSQL" as DB
participant "JwtService" as JWT
participant "JwtAuthenticationFilter" as F
participant "BillAPIController" as BC
participant "CurrentUserAccess" as ACC

== Đăng nhập ==
U -> FE : Nhập tên đăng nhập, mật khẩu
FE -> AC : POST /api/auth/login\n{username, password}
AC -> AM : authenticate(username, password)
AM -> UDS : loadUserByUsername(username)
UDS -> DB : tìm User theo tên
DB --> UDS : User
alt Không tồn tại hoặc tài khoản bị vô hiệu hóa
  UDS --> AM : UsernameNotFoundException
  AM --> AC : AuthenticationException
  AC --> FE : 401 Authentication failed
  FE --> U : Báo đăng nhập thất bại
else Tài khoản đang hoạt động
  UDS --> AM : UserDetails (ROLE_ADMIN | ROLE_USER)
  AM -> AM : So khớp mật khẩu BCrypt
  alt Sai mật khẩu
    AM --> AC : BadCredentialsException
    AC --> FE : 401 Authentication failed
    FE --> U : Báo đăng nhập thất bại
  else Đúng mật khẩu
    AM --> AC : Authentication
    AC -> JWT : generateToken(username, role)
    JWT --> AC : JWT (HS256, hết hạn sau 1 giờ)
    AC --> FE : 200 OK + JWT
    FE -> FE : Lưu token vào localStorage,\nđọc role trong token
    FE --> U : Chuyển tới trang cư dân (/user/profile)\nhoặc trang quản trị (/admin)
  end
end

== Gọi API đã xác thực ==
U -> FE : Mở **Bill Payment Service**
FE -> F : GET /api/bills/list\nAuthorization: Bearer <JWT>
F -> JWT : extractUsername, extractRole
alt Token hợp lệ
  JWT --> F : username, role
  F -> F : Đặt Authentication vào SecurityContext
  F -> BC : chuyển request
  BC -> DB : lấy danh sách khoản thu
  DB --> BC : danh sách Bill
  BC -> ACC : isAdmin()?
  alt Cư dân
    ACC --> BC : false
    BC -> ACC : canAccessApartment(số căn hộ) cho từng khoản
    ACC -> DB : lấy căn hộ của cư dân đang đăng nhập
    DB --> ACC : apartmentNumbers
    ACC --> BC : chỉ giữ khoản thu của căn hộ mình
  else Ban quản lý
    ACC --> BC : true (xem tất cả)
  end
  BC --> FE : 200 OK + danh sách khoản thu
  FE --> U : Hiện số tiền, hạn đóng, trạng thái
else Token sai hoặc hết hạn
  JWT --> F : lỗi
  F --> FE : 403 Forbidden (không có Authentication)
  FE --> U : Yêu cầu đăng nhập lại
end
@enduml
