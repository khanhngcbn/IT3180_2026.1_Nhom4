@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam activity {
  BackgroundColor #F5F9FF
  BorderColor #3A6EA5
}
title Activity Diagram - Tạo khoản thu điện, nước hàng loạt (US07)

|Ban quản lý / Kế toán|
start
:Mở màn hình **Utility Bills Creation**;
|Hệ thống (Backend)|
:GET /api/utility-bills;
:Lấy danh sách căn hộ, bỏ các căn hộ trống (VACANT);
:Đọc đơn giá điện (đ/kWh), nước (đ/m³)
từ bảng đơn giá (US05);
:Trả tháng/năm hiện tại và hạn đóng mặc định = hôm nay + 5 ngày;
|Ban quản lý / Kế toán|
:Nhập lượng điện (kWh), nước (m³) cho từng căn hộ;
:Chọn hạn đóng;
:Gửi yêu cầu tạo khoản thu;
|Hệ thống (Backend)|
:POST /api/utility-bills/generate;
:Đọc lại đơn giá điện, nước hiện hành;
while (Còn căn hộ trong dữ liệu gửi lên?) is (còn)
  if (Lượng điện > 0?) then (có)
    :Tạo khoản thu ELECTRICITY
    số tiền = kWh × đơn giá điện,
    trạng thái UNPAID;
  endif
  if (Lượng nước > 0?) then (có)
    :Tạo khoản thu WATER
    số tiền = m³ × đơn giá nước,
    trạng thái UNPAID;
  endif
endwhile (hết)
if (Có lỗi khi đọc dữ liệu\n(số không hợp lệ, thiếu hạn đóng)?) then (có)
  :Trả 400 "Lỗi khi tạo khoản thu: ...",
  không lưu khoản thu nào;
  |Ban quản lý / Kế toán|
  :Sửa dữ liệu và gửi lại;
  stop
else (không)
  |Hệ thống (Backend)|
  :Lưu tất cả khoản thu mới;
  :Gắn mã khoản thu vào căn hộ tương ứng;
  :Trả "Đã tạo N khoản thu điện nước!";
  |Ban quản lý / Kế toán|
  :Xem kết quả;
  note right
    Cư dân của căn hộ thấy ngay các khoản này
    ở màn hình **Bill Payment Service** (US08)
  end note
  stop
endif
@enduml
