@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam node {
  BackgroundColor #F5F9FF
  BorderColor #3A6EA5
}
title Deployment Diagram - Triển khai BlueMoon

node "Máy người dùng" <<device>> as Client {
  node "Trình duyệt web" <<execution environment>> as Browser {
    artifact "BlueMoon SPA\n(React build)" as SPA
    artifact "JWT trong localStorage" as Token
  }
}

node "Máy chủ web tĩnh" <<server>> as WebServer {
  node "Node.js 18+ (npm start, cổng 3000)\nhoặc web server tĩnh phục vụ build/" <<execution environment>> as NodeEnv {
    artifact "Frontend/build\n(npm run build)" as FEBuild
  }
}

node "Máy chủ ứng dụng" <<server>> as AppServer {
  node "JRE 17 trên máy chủ\nhoặc container openjdk:17 (Backend/Dockerfile)" <<execution environment>> as JRE {
    artifact "app.jar\nSpring Boot 3.4.3 + Tomcat nhúng\ncổng 9090" as Jar
    component "Bộ nhớ OTP (Caffeine)" as OtpCache
  }
  artifact "Biến môi trường\nDB_URL, DB_USERNAME, DB_PASSWORD,\nMAIL_USERNAME, MAIL_PASSWORD, JWT_SECRET" as Env
}

node "Docker host" <<server>> as DockerHost {
  node "Container postgres:16\ncổng 5432" <<container>> as PgContainer {
    database "chungcu_db" as DB
  }
  storage "Volume bluemoon_pgdata" as Volume
}

cloud "Google" as Google {
  node "smtp.gmail.com:587\n(STARTTLS, App Password)" <<external>> as Smtp
}

Browser --> WebServer : HTTP(S)\ntải SPA
SPA --> Jar : HTTP(S) REST /api/**\nJSON + Authorization: Bearer JWT\n(CORS: http://localhost:3000, ...)
Jar --> DB : JDBC PostgreSQL\n(Hibernate ddl-auto=update)
DB --> Volume : lưu dữ liệu
Jar --> Smtp : SMTP\ngửi email OTP
Env ..> Jar : cấu hình khi khởi động
@enduml
